# UniFi controller URL (include port, e.g. https://unifi.example.com or https://192.168.1.1:8443)
UNIFI_URL=https://

# UniFi local admin credentials (use a read-only account)
UNIFI_USERNAME=diag-readonly
UNIFI_PASSWORD=

# Whether to verify the UniFi controller's TLS certificate (false = accept self-signed)
UNIFI_VERIFY_TLS=false

# UniFi site name (default is "default")
UNIFI_SITE=default

# Diagnostic server port (default 8080)
SERVER_PORT=8080

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Session data retention in days (0 = unlimited)
DATA_RETENTION_DAYS=30

# Maximum number of stored sessions (older ones are pruned)
MAX_STORED_SESSIONS=10000

# Set to true to disable all persistence (in-memory only, data lost on restart)
# NO_PERSISTENCE=false

# Internet latency test endpoint (fetched from the client's browser)
INTERNET_TEST_URL=https://one.one.one.one

# Page title shown in the browser and UI (default: Wi-Fi Diagnostics)
# SITE_TITLE=Wi-Fi Diagnostics

# Contact info shown in the page footer (both optional)
# CONTACT_NAME=IT Support
# CONTACT_EMAIL=support@example.com

# Comma-separated list of trusted proxy IPs (only if behind a reverse proxy)
# TRUSTED_PROXIES=192.168.1.100
